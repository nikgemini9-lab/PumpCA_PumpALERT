{
  "name": "pump-alert",
  "version": "1.0.0",
  "description": "24/7 pump.fun CA tracker with Telegram alerts for AXIOM holders",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -r src/public dist/public",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "ts-node-dev --respawn --transpile-only src/index.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "axios": "^1.6.8",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-telegram-bot-api": "^0.65.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/node-telegram-bot-api": "^0.64.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}

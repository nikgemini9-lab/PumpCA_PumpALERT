# ============================
# REQUIRED
# ============================

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Telegram chat ID — send /start to your bot, it will tell you
TELEGRAM_CHAT_ID=123456789

# ============================
# SOLANA RPC (choose one)
# ============================

# Option A: Free Helius key (recommended — stable WebSocket, 1M req/mo free)
# Get at https://dev.helius.xyz
HELIUS_API_KEY=

# Option B: Custom RPC (QuickNode, Alchemy, etc.)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ============================
# ALERT THRESHOLDS (optional, defaults shown)
# ============================

# Alert when price increases X% in the last 5 minutes (DexScreener)
PRICE_CHANGE_ALERT_PERCENT=15

# Alert when X buys happen within the rolling window (on-chain)
BUY_COUNT_ALERT=5

# Rolling window for buy count (minutes)
BUY_COUNT_WINDOW_MINUTES=5

# Minutes to wait before alerting the same token again (cooldown)
ALERT_COOLDOWN_MINUTES=10

# DexScreener poll interval (seconds)
POLL_INTERVAL_SECONDS=30

# ============================
# SERVER
# ============================
PORT=3000
